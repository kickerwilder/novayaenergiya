# Пример настроек бота. Скопируйте в bot/.env (этот файл в .gitignore) и подставьте свои значения.
# Реальные ключи, токены, прокси и адрес сервера НИКОГДА не коммитить и не вставлять в чаты.

# --- LLM (обязательно): выберите ОДИН из двух наборов ---
# PROVIDER: gemini (по умолчанию, поведение бота не меняется) или openai (любой OpenAI-совместимый API chat/completions).
# Смена провайдера = смена переменных в этом блоке и перезапуск, код не меняется (bot/DEPLOY.md, раздел «Смена провайдера модели»).

# Набор 1. Gemini (по умолчанию)
PROVIDER=gemini
PROVIDER_API_KEY=ВСТАВЬТЕ_КЛЮЧ_GOOGLE_AI_STUDIO
# Модель Flash/Flash-Lite класса (актуальные имена: официальная страница моделей Gemini API)
MODEL=gemini-3.5-flash-lite
FALLBACK_MODEL=gemini-3.1-flash-lite

# Набор 2. OpenAI-совместимый провайдер (раскомментируйте, а набор 1 закомментируйте)
# Адрес API, ключ и ТОЧНЫЕ названия моделей берутся из личного кабинета провайдера.
# PROVIDER=openai
# PROVIDER_API_KEY=КЛЮЧ_ИЗ_КАБИНЕТА_ПРОВАЙДЕРА
# К адресу бот добавляет /chat/completions (если в кабинете дан полный адрес с этим хвостом, укажите его как есть).
# PROVIDER_BASE_URL=АДРЕС_API_ИЗ_КАБИНЕТА
# MODEL=НАЗВАНИЕ_МОДЕЛИ_ИЗ_КАБИНЕТА
# Запасная модель необязательна: пусто или не задана = без запасной.
# FALLBACK_MODEL=НАЗВАНИЕ_ЗАПАСНОЙ_МОДЕЛИ_ИЗ_КАБИНЕТА
# Необязательно: дополнительные поля запроса и заголовки (JSON одной строкой; значение null удаляет поле или заголовок).
# Нужны, например, чтобы отключить режим рассуждений у конкретной модели или передать заголовок, который требует провайдер.
# PROVIDER_EXTRA_BODY={"имя_поля": "значение"}
# PROVIDER_EXTRA_HEADERS={"Имя-Заголовка": "значение"}
# Некорректный JSON: бот не запустится и покажет, какая переменная неверна (значения не печатаются).

# --- Прокси (сервер в Москве: Gemini и Telegram напрямую недоступны) ---
# SOCKS5 или HTTP прокси ТОЛЬКО для исходящих запросов к LLM и Telegram. Пусто = запросы идут напрямую.
# Остальной трафик сервера (apt, git, сайт) прокси не использует.
# Формат: socks5://ЛОГИН:ПАРОЛЬ@ХОСТ:ПОРТ  или  http://ЛОГИН:ПАРОЛЬ@ХОСТ:ПОРТ
PROXY_URL=
# LLM_USE_PROXY: 1 (по умолчанию) = запросы к модели идут через PROXY_URL, как раньше; 0 = к модели напрямую
# (нужно, если провайдер доступен из России без прокси), а PROXY_URL остаётся только для Telegram.
LLM_USE_PROXY=1

# --- Передача менеджеру (Telegram) ---
# Токен бота от @BotFather и chat id менеджера (узнать: node tg_chat_id.js после сообщения боту). Пусто = уведомления выключены.
# Только отправка (sendMessage) и опрос (getUpdates) через PROXY_URL; вебхук не используется.
TELEGRAM_BOT_TOKEN=
TELEGRAM_MANAGER_CHAT_ID=

# --- Сайт и доступ ---
# Адреса сайта, которым разрешён CORS (через запятую). По умолчанию: https://novaya-energy.ru и https://www.novaya-energy.ru
ALLOWED_ORIGINS=https://novaya-energy.ru,https://www.novaya-energy.ru
# 1 = разрешить запросы с http://localhost и 127.0.0.1 (только локальная разработка и тесты; на сервере не включать)
ALLOW_LOCALHOST=0
# База знаний: адрес data/kb.json на сайте (кэш 5 минут) или путь к файлу. Пусто = читать ../data/kb.json с диска
# (в Docker том /srv/site/data монтируется в /app/data, поэтому пусто)
KB_URL=

# --- Лимиты ---
# Суточный лимит запросов ко всему боту и лимит на одного клиента (запросов за окно, секунд)
DAILY_CAP=500
RATE_LIMIT=20
RATE_WINDOW_S=600

# --- Необязательно ---
# PORT=8787                 порт (в Docker задаётся compose)
# HOST=127.0.0.1            слушать только этот адрес (локальная разработка; в Docker задаётся compose)
# TRUST_PROXY=1             брать IP клиента из X-Forwarded-For (бот за Caddy; в Docker задаётся compose)
# THINKING_LEVEL=minimal    уровень «размышлений» модели (только Gemini; у других провайдеров используйте PROVIDER_EXTRA_BODY)
# MAX_OUTPUT_TOKENS=600     предел длины ответа модели
# TIMEOUT_MS=20000          общий бюджет времени на один ответ клиенту (повторы и запасная модель укладываются в него)
# RETRY_PAUSE_MS=1000       пауза перед повтором при 429 или 5xx, если провайдер не прислал Retry-After
# RETRY_MAX_WAIT_MS=3000    дольше этого паузу не ждём: бот сразу переходит к запасной модели
# RATE_SALT=                соль для хэша IP в лимитере (по умолчанию случайная при запуске)
# Для тестов: TEST_TRACE=1 добавляет в ответ trace с результатами инструментов. В рабочем режиме НЕ включать.
