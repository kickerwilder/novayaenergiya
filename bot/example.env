# Пример настроек бота. Скопируйте в bot/.env (этот файл в .gitignore) и подставьте свои значения.
# Реальный ключ и прокси НИКОГДА не коммитить и не вставлять в чаты.

PROVIDER_API_KEY=
# SOCKS5 или HTTP прокси для запросов к Gemini (если сервер находится в регионе, где API недоступен)
PROXY_URL=

# Модель Flash/Flash-Lite класса (актуальные имена: официальная страница моделей Gemini API)
MODEL=gemini-3.5-flash-lite
FALLBACK_MODEL=gemini-3.1-flash-lite

# База знаний: адрес data/kb.json на сайте (кэш 5 минут). Пусто = читать ../data/kb.json с диска (локальная разработка)
KB_URL=

# Адреса сайта, которым разрешён CORS (через запятую)
ALLOWED_ORIGINS=https://kickerwilder.github.io

# Суточный лимит запросов ко всему боту и лимит на одного клиента (запросов за окно, секунд)
DAILY_CAP=500
RATE_LIMIT=20
RATE_WINDOW_S=600

# 1 = писать в лог текст вопросов (без IP и метаданных)
LOG_QUESTIONS=0

# Необязательно: PORT=8787, HOST=127.0.0.1 (слушать только этот компьютер), TRUST_PROXY=1 (если сервер за nginx), THINKING_LEVEL=minimal, TIMEOUT_MS=20000
