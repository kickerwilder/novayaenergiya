# =====================================================================================================
# ЗАМЕНИТЬ НА СЕРВЕРЕ (реальные значения в репозиторий не вносить, он публичный):
#   1. ВАШ_EMAIL    — блок { } ниже: e-mail для уведомлений Let's Encrypt.
#   2. ХЭШ_ПАРОЛЯ   — блок preview.novaya-energy.ru внизу файла: вывод команды `caddy hash-password`.
# Проверка после правки (вывод должен быть пустым: незаменённых значений в действующих строках нет):
#   grep -nE '^[^#]*(ВАШ_EMAIL|ХЭШ_ПАРОЛЯ)' /etc/caddy/Caddyfile
# =====================================================================================================
# Шаблон Caddyfile для VPS (Ubuntu 24.04, Caddy 2.8+: директива basic_auth). Копируется в /etc/caddy/Caddyfile,
# перед включением: caddy validate --config /etc/caddy/Caddyfile
# Секретов и IP здесь нет. Порядок запуска, переноса и проверки: bot/DEPLOY.md.
#
# Два сервиса на одном сервере:
#   1) bot.novaya-energy.ru  — бот (reverse proxy на 127.0.0.1:8787), всегда закрыт от индексации
#   2) novaya-energy.ru и www — сайт из /srv/site (статические файлы)

{
	# e-mail для уведомлений Let's Encrypt (замените на свой)
	email ВАШ_EMAIL
}

# Общие заголовки безопасности (подключаются во всех блоках)
(security_headers) {
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		# HSTS короткий: через неделю после проверки поднять до max-age=31536000 и только потом думать о includeSubDomains
		Strict-Transport-Security "max-age=300"
		-Server
	}
}

# Раздача сайта из /srv/site (общая для основного домена и временного preview)
(site_files) {
	root * /srv/site
	encode zstd gzip
	import security_headers

	# --- внутренние пути закрыты (404). Список совпадает с exclude в _config.yml (GitHub Pages) и с исключениями деплоя (.github/workflows/deploy.yml)
	@internal path /data/source /data/source/* /data/naming.json /README.md /SKILL.md /scripts /scripts/* /tests /tests/* /bot /bot/* /.claude /.claude/* /.git /.git/* /.github /.github/* /_config.yml /CNAME /Gemfile /Gemfile.lock /vendor/* /node_modules/*
	# служебные расширения и файлы разработки
	@internal_ext path *.md *.py *.yml *.yaml *.env *.sh *.lock /package.json /package-lock.json /Dockerfile /docker-compose.yml
	# любые файлы и каталоги с точки (кроме /.well-known/)
	@dotfiles {
		path_regexp dotfiles (^|/)\.
		not path /.well-known/*
	}
	handle @internal {
		error 404
	}
	handle @internal_ext {
		error 404
	}
	handle @dotfiles {
		error 404
	}

	# --- всё остальное: обычные файлы (robots.txt, sitemap.xml, файл ключа IndexNow <ключ>.txt, data/*.js, data/kb.json, картинки и т. д.)
	handle {
		# кэш (в адресах файлов нет версии, поэтому код и данные перепроверяются часто; ETag отдаёт file_server, повторный запрос получает 304):
		#   главная, sitemap.xml, robots.txt: no-cache (перед использованием всегда проверять на сервере)
		@nocache path / /index.html /sitemap.xml /robots.txt
		header @nocache Cache-Control "no-cache"
		#   остальные страницы (privacy.html, models/*.html и т. п.): 5 минут
		@pages {
			path *.html
			not path /index.html
		}
		header @pages Cache-Control "public, max-age=300, must-revalidate"
		#   js, css и всё в data/: 5 минут
		@code path *.js *.css /data/*
		header @code Cache-Control "public, max-age=300, must-revalidate"
		#   img/ (в том числе hero.mp4) и fonts/: 30 дней. Заменяя картинку, видео или шрифт, давайте новое имя файла
		@static path /img/* /fonts/*
		header @static Cache-Control "public, max-age=2592000"
		#   значки в корне сайта: неделя (в страницах у них есть ?v=)
		@icons path /favicon.ico /favicon.svg /apple-touch-icon.png /icon-192.png /icon-512.png
		header @icons Cache-Control "public, max-age=604800"

		# file_server сам отдаёт Range-запросы (частичные ответы 206): нужно для img/hero.mp4
		file_server
	}

	# --- свой 404 из /srv/site/404.html с кодом 404
	handle_errors {
		# защитные заголовки (в том числе HSTS) на ответы с ошибкой из основного блока не переносятся, поэтому подключаются и здесь
		import security_headers
		# ошибки не кэшировать: без этого 404 на отсутствующий файл из img/ или assets/ получил бы долгий срок хранения своего пути
		header Cache-Control "no-cache"
		@notfound expression {err.status_code} == 404
		handle @notfound {
			rewrite * /404.html
			file_server
		}
	}
}

# ---------------------------------------------------------------------------------------------------------
# 1) Бот. HTTPS выпускается автоматически. Поддомен закрыт от поисковиков: заголовок и robots.txt с Disallow: /
# ---------------------------------------------------------------------------------------------------------
bot.novaya-energy.ru {
	encode zstd gzip
	import security_headers
	header X-Robots-Tag "noindex, nofollow"

	handle /robots.txt {
		header Content-Type "text/plain; charset=utf-8"
		respond <<TXT
			User-agent: *
			Disallow: /
			TXT 200
	}

	handle {
		# бот слушает только 127.0.0.1 (docker-compose публикует порт на локальный адрес)
		reverse_proxy 127.0.0.1:8787
	}
}

# ---------------------------------------------------------------------------------------------------------
# 2) Сайт. Канонический адрес: https://novaya-energy.ru/ (без www; так указано в canonical и sitemap.xml),
#    поэтому www редиректит на него; адреса страниц не меняются.
# ---------------------------------------------------------------------------------------------------------
www.novaya-energy.ru {
	redir https://novaya-energy.ru{uri} permanent
}

novaya-energy.ru {
	# Основной сайт открыт для индексации (INDEXABLE = True в scripts/indexing.py), поэтому заголовка X-Robots-Tag здесь нет.
	# Закрывать только вместе с INDEXABLE = False и по решению владельца (bot/DEPLOY.md, пункт 3.12).
	# Переезды и удалённые адреса: когда в data/source/redirects.json появятся записи, скопируйте сгенерированный bot/deploy/redirects.caddy
	# рядом с этим файлом и раскомментируйте следующую строку (без неё правила не действуют):
	# import redirects.caddy
	import site_files
}

